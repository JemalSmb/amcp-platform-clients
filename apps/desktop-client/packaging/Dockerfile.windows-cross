FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 python3-venv python3-pip cmake ninja-build zip unzip ca-certificates \
      g++-mingw-w64-x86-64-posix gcc-mingw-w64-x86-64-posix mingw-w64-tools \
      libgl1 libglib2.0-0 libfontconfig1 libxkbcommon0 libdbus-1-3 \
    && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/aqt && /opt/aqt/bin/pip install --no-cache-dir aqtinstall
# Host Qt (runs moc/rcc/uic on Linux) + target Qt (the Windows/MinGW libraries we link against). Same version.
RUN /opt/aqt/bin/aqt install-qt linux desktop 6.7.3 linux_gcc_64 --outputdir /opt/qt \
 && /opt/aqt/bin/aqt install-qt windows desktop 6.7.3 win64_mingw --outputdir /opt/qt
